{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sticky Wall",
  "version": "0.0.1",
  "identifier": "com.siyeonkang.sticktoit",
  "build": {
    "frontendDist": "../dist/public",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sticky Wall",
        "width": 1200,
        "height": 800,
        "minWidth": 600,
        "minHeight": 400,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "passive"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/TODO-OWNER/TODO-REPO/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVCODc4MkY4QkZCNzBEMkMKUldRc0RiZS8rSUtIV3dBVFlaUmpYcVkvdzJrbncrWld3NTRtRENGcGI3T2k5MXRrSjRNR3BLMWoK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
