{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the main Sticky Wall window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "window-state:default",
    "path:default",
    "fs:scope-app-data",
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        { "path": "$APPDATA/notes.json" }
      ]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [
        { "path": "$APPDATA/notes.json" },
        { "path": "$APPDATA/notes.json.tmp" }
      ]
    },
    {
      "identifier": "fs:allow-rename",
      "allow": [
        { "path": "$APPDATA/notes.json.tmp" },
        { "path": "$APPDATA/notes.json" }
      ]
    }
  ]
}
